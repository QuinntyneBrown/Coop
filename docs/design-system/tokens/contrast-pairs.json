{
  "$comment": "Foreground/background token pairs checked by check_contrast.py. 4.5:1 is WCAG 2.2 AA for normal text (1.4.3); 3:1 is AA for large text, UI component edges and focus indicators (1.4.11). Light theme only: the implemented product has no dark theme.",
  "pairs": [
    { "fg": "--color-fg-default", "bg": "--color-bg-canvas", "min": 4.5, "note": "body text on page" },
    { "fg": "--color-fg-default", "bg": "--color-bg-surface", "min": 4.5, "note": "body text on cards, dialogs and inputs" },
    { "fg": "--color-fg-default", "bg": "--color-bg-subtle", "min": 4.5, "note": "text on hovered rows and quick actions" },
    { "fg": "--color-fg-default", "bg": "--color-bg-subtle-hover", "min": 4.5, "note": "text on hovered quick actions" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-canvas", "min": 4.5, "note": "secondary text on page" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-surface", "min": 4.5, "note": "secondary text on cards, dates, labels" },
    { "fg": "--color-fg-muted", "bg": "--color-bg-subtle", "min": 4.5, "note": "secondary text on hovered rows" },
    { "fg": "--color-fg-muted", "bg": "--color-accent-subtle", "min": 4.5, "note": "secondary text on selected rows" },
    { "fg": "--color-fg-subtle", "bg": "--color-bg-surface", "min": 4.5, "note": "placeholders inside inputs" },
    { "fg": "--color-fg-subtle", "bg": "--color-bg-canvas", "min": 4.5, "note": "metadata on page" },
    { "fg": "--color-fg-inverse", "bg": "--color-bg-inverse", "min": 4.5, "note": "text on inverse surface" },
    { "fg": "--color-fg-link", "bg": "--color-bg-surface", "min": 4.5, "note": "links on cards" },
    { "fg": "--color-fg-link", "bg": "--color-bg-canvas", "min": 4.5, "note": "links on page" },
    { "fg": "--color-fg-link-hover", "bg": "--color-bg-surface", "min": 4.5, "note": "hovered links" },
    { "fg": "--color-fg-accent", "bg": "--color-bg-surface", "min": 4.5, "note": "active bottom-tab label, outline button label" },
    { "fg": "--color-fg-accent", "bg": "--color-accent-subtle", "min": 4.5, "note": "active sidebar link" },
    { "fg": "--color-fg-accent", "bg": "--color-accent-subtle-hover", "min": 4.5, "note": "hovered outline button label" },
    { "fg": "--color-fg-default", "bg": "--color-accent-subtle", "min": 4.5, "note": "body text on selected row" },
    { "fg": "--color-fg-on-accent", "bg": "--color-accent", "min": 4.5, "note": "primary button, active filter, avatar initials" },
    { "fg": "--color-fg-on-accent", "bg": "--color-accent-hover", "min": 4.5, "note": "primary button label (hover)" },
    { "fg": "--color-fg-on-accent", "bg": "--color-accent-active", "min": 4.5, "note": "primary button label (active)" },
    { "fg": "--color-accent", "bg": "--color-bg-surface", "min": 3, "note": "outline button edge on card" },
    { "fg": "--color-accent", "bg": "--color-bg-canvas", "min": 3, "note": "outline button edge on page" },
    { "fg": "--color-brand", "bg": "--color-bg-surface", "min": 3, "note": "logo mark and decorative icons (non-text)" },
    { "fg": "--color-border-strong", "bg": "--color-bg-surface", "min": 3, "note": "input borders (1.4.11)" },
    { "fg": "--color-border-strong", "bg": "--color-bg-canvas", "min": 3, "note": "input borders on page" },
    { "fg": "--color-focus-ring", "bg": "--color-bg-surface", "min": 3, "note": "focus ring vs card (2.4.11)" },
    { "fg": "--color-focus-ring", "bg": "--color-bg-canvas", "min": 3, "note": "focus ring vs page" },
    { "fg": "--color-focus-ring", "bg": "--color-accent-subtle", "min": 3, "note": "focus ring vs selected row" },
    { "fg": "--color-fg-on-danger", "bg": "--color-danger-solid", "min": 4.5, "note": "destructive button label" },
    { "fg": "--color-fg-on-danger", "bg": "--color-danger-solid-hover", "min": 4.5, "note": "destructive button label (hover)" },
    { "fg": "--color-danger-solid", "bg": "--color-bg-surface", "min": 3, "note": "invalid input border, sign-out edge" },
    { "fg": "--color-danger-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "field error text under input" },
    { "fg": "--color-danger-fg", "bg": "--color-danger-subtle", "min": 4.5, "note": "error message block" },
    { "fg": "--color-info-fg", "bg": "--color-info-bg", "min": 4.5, "note": "info badge text" },
    { "fg": "--color-info-icon", "bg": "--color-info-bg", "min": 3, "note": "info icon" },
    { "fg": "--color-success-fg", "bg": "--color-success-bg", "min": 4.5, "note": "success alert and badge text" },
    { "fg": "--color-success-icon", "bg": "--color-success-bg", "min": 3, "note": "success icon" },
    { "fg": "--color-warning-fg", "bg": "--color-warning-bg", "min": 4.5, "note": "warning badge text" },
    { "fg": "--color-warning-icon", "bg": "--color-warning-bg", "min": 3, "note": "warning icon" },
    { "fg": "--color-danger-fg", "bg": "--color-danger-bg", "min": 4.5, "note": "danger alert and badge text" },
    { "fg": "--color-danger-icon", "bg": "--color-danger-bg", "min": 3, "note": "danger icon" },
    { "fg": "--color-success-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "success text on cards" },
    { "fg": "--color-info-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "info text on cards" },
    { "fg": "--color-warning-fg", "bg": "--color-bg-surface", "min": 4.5, "note": "warning text on cards" }
  ]
}
