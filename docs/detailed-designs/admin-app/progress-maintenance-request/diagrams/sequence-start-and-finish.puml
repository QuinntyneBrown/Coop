@startuml
title UML sequence behaviour — Start and finish a request, and refuse a skipped step
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Office administrator" as actor
actor "Member" as member
box "Frontend — Admin and public applications" #E0F2FE
  participant "MaintenanceComponent (admin)" as screen
  participant "MaintenanceComponent (public)" as memberScreen
end box
box "Backend — Coop API" #FEF3C7
  participant "MaintenanceRequestController" as controller
  participant "ValidationBehavior" as validation
  participant "StartMaintenanceRequestHandler" as start
  participant "CompleteMaintenanceRequestHandler" as complete
  participant "ExceptionHandlingMiddleware" as middleware
  database "CoopDbContext" as db
end box
actor -> screen : opens a Received request
screen --> actor : "Start work"  [L2-REQ-085 AC2]
actor -> screen : "Start work"
screen -> controller : PUT api/maintenancerequest/start { maintenanceRequestId }
controller -> validation : Send(StartMaintenanceRequestRequest)
validation -> start : request is not New
start -> db : load; Start(profileId) returns Start event
start -> db : add StoredEvent, SaveChanges  [L2-REQ-023 AC5]
controller --> screen : 200 { maintenanceRequest: Started }
screen --> actor : status "Started", "Finish work"
member -> memberScreen : opens the request
memberScreen --> member : status "Started"  [L2-REQ-086 AC1]
actor -> screen : "Finish work"
screen -> controller : PUT api/maintenancerequest/complete
controller -> validation : Send(CompleteMaintenanceRequestRequest)
validation -> complete : request is Started or Completed
complete -> db : Complete(profileId), add StoredEvent, SaveChanges  [L2-REQ-024 AC4]
controller --> screen : 200 { maintenanceRequest: Completed }
screen --> actor : status "Completed", no next step  [L2-REQ-085 AC4]
member -> memberScreen : opens the request
memberScreen --> member : status "Done"  [L2-REQ-086 AC2]
== The same step is posted again ==
screen -> controller : PUT api/maintenancerequest/complete
complete --> controller : already Completed: no change, no event  [ADR 0004]
controller --> screen : 200 { maintenanceRequest: Completed }
== A step is skipped ==
screen -> controller : PUT api/maintenancerequest/complete (request is New)
controller -> validation : Send(CompleteMaintenanceRequestRequest)
validation --> middleware : ValidationException
middleware --> screen : 400 "Only a started request can be finished."  [L2-REQ-024 AC3]
screen --> actor : alert "That change was not saved. Please try again."  [L2-REQ-085 AC5]
@enduml
