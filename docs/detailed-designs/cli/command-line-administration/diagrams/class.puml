@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Command-Line Administration

package "Coop.Cli" {
  class CliApp {
    +RunAsync(args, output, error, configureServices) : Task<int>
  }
  class CliRunner {
    +SendAsync(request) : Task<TResponse>
    +WriteLine(text)
  }
  class OperatorIdentity {
    +Create() : ClaimsPrincipal
  }
  class CliException
  class DbCommands
  class UserCommands
  class RoleCommands
  class InvitationCommands
  class SiteContentCommands
  class PageCommands
  class BoardCommands
  class AssetCommands
  class ThemeCommands
  class DocumentCommands
  class DemoSeed {
    +SeedAsync(context, hasher, apiUrl)
  }
  class DemoPhotos {
    +All() : IEnumerable<(name, bytes, width, height)>
  }
}

package "Coop.Infrastructure" {
  class Dependencies {
    +AddCoopCore(services, configuration)
  }
  class SeedData {
    +SeedAsync(context, hasher)
    +SeedRolesAsync(context)
    +SeedSiteContentAsync(context, content)
  }
  class SiteContentSeed {
    +Create(photo) : SiteContentDto
  }
}

package "Coop.Application.Identity" {
  class CredentialRules {
    +Username()
    +Password()
  }
  class AddUserRoleRequest {
    +Guid UserId
    +Guid RoleId
  }
  class RemoveUserRoleRequest {
    +Guid UserId
    +Guid RoleId
  }
  class UpdateUserValidator
  class SetPasswordValidator
  class RemoveUserValidator
  class RemoveUserRoleValidator
}

CliApp --> CliRunner
CliApp --> OperatorIdentity
CliApp --> Dependencies
CliApp --> DbCommands
CliApp --> UserCommands
CliApp --> RoleCommands
CliApp --> InvitationCommands
CliApp --> SiteContentCommands
CliApp --> PageCommands
CliApp --> BoardCommands
CliApp --> AssetCommands
CliApp --> ThemeCommands
CliApp --> DocumentCommands
DbCommands --> SeedData
DbCommands --> DemoSeed
DbCommands --> CredentialRules
DemoSeed --> DemoPhotos
DemoSeed --> SiteContentSeed
SeedData --> SiteContentSeed
UserCommands --> AddUserRoleRequest
UserCommands --> RemoveUserRoleRequest
UserCommands ..> CliException
@enduml
