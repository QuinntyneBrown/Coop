@startuml
title UML sequence behaviour — Set a user's password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Operator" as operator
box "Coop.Cli" #DCFCE7
  participant "CliApp" as app
  participant "UserCommands" as users
end box
box "Coop.Application" #FEF3C7
  participant "ValidationBehavior" as validation
  participant "SetPasswordHandler" as handler
end box
database "Coop database" as db
operator -> app : coop user set-password --username edna --password NewPass34
app -> users : invoke set-password
users -> handler : Send(GetUsersRequest)
handler --> users : users
alt no user named edna
  users --> app : CliException("No user named \"edna\".")
  app --> operator : message, exit code 1  [L2-REQ-102 AC5]
else user found
  users -> validation : Send(SetPasswordRequest { UserId, Password })
  alt password shorter than 6 characters
    validation --> app : ValidationException
    app --> operator : "Error:" and the rule's message, exit code 1  [L2-REQ-105 AC4]
  else valid
    validation -> handler : Handle
    handler -> db : save new hash
    handler --> users : UserDto (no hash, no salt)
    users --> operator : Password set for "edna"., exit code 0
  end
end
@enduml
