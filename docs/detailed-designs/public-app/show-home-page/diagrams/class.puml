@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Show the home page

class LandingComponent {
  +content: Signal<SiteContent>
  +home: Signal<HomeContent>
  +boardMembers: Signal<BoardMemberView[]>
  +notices: Signal<NoticeView[]>
}

class SiteContentService {
  +content: Signal<SiteContent>
}

class SiteContent {
  +header: SiteHeaderContent
  +footer: SiteFooterContent
  +home: HomeContent
}

class HomeContent {
  +hero: HeroContent
  +glance: GlanceContent
  +about: AboutContent
  +gallery: GalleryContent
  +features: FeaturesContent
  +notices: NoticesContent
  +board: SectionHead
  +quote: QuoteContent
  +visit: VisitContent
}

class HeroContent {
  +eyebrow: string
  +title: string
  +lead: string
  +badge: string
  +primaryAction: SiteLink
  +secondaryAction: SiteLink
  +photo: SitePhoto
}

class SitePhoto {
  +src: string
  +alt: string
  +width: number
  +height: number
}

class SiteLink {
  +label: string
  +href: string
}

class "mergeContent, SITE_DEFAULTS" as Defaults <<functions>>

class BoardMemberView {
  +name: string
  +title: string
  +initials: string
  +avatarUrl?: string
}

class NoticeView {
  +id: string
  +title: string
  +excerpt: string
  +day: string
  +month: string
  +dateLabel: string
  +dateTime: string
}

class "landing-view-model" as VM <<functions>> {
  +boardMembersFrom(content): BoardMemberView[]
  +boardMembersFromApi(response): BoardMemberView[]
  +noticeViewFrom(notice): NoticeView
  +excerptOf(text, max): string
}

class JsonContentService {
  +getByName(name): Observable<JsonContent | null>
}

class ApiService {
  +get<T>(path): Observable<T>
}

LandingComponent ..> SiteContentService : reads the merged content
SiteContentService ..> Defaults : lays the published content over
SiteContentService ..> ApiService : GET site-content
SiteContent *-- HomeContent
HomeContent *-- HeroContent
HeroContent --> SitePhoto
HeroContent --> SiteLink
LandingComponent ..> VM : maps responses with
LandingComponent ..> JsonContentService : loads BoardOfDirectors
LandingComponent ..> ApiService : loads notices, board members
VM ..> BoardMemberView : produces
VM ..> NoticeView : produces
@enduml
